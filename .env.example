# Firebase Web SDK config — copy to `.env` and fill in your project values.
# Restart the dev server after editing.
#
# Either VITE_FIREBASE_* (recommended after the Vite migration) or the
# legacy REACT_APP_FIREBASE_* prefix is accepted; firebase.js reads both.
# If you keep the old REACT_APP_* names, make sure vite.config.mjs's
# shim is active (it is, by default).

# --- Vite-native (recommended) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — required only if you want browser push notifications (FCM).
# Generate at: Firebase Console → Project Settings → Cloud Messaging → Web
# Push certificates → Generate key pair.
VITE_FIREBASE_VAPID_KEY=

# --- Legacy CRA names (still work) ---
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your-project
# REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
# REACT_APP_FIREBASE_MEASUREMENT_ID=
